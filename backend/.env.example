# 백엔드 환경변수 목록. 복사해서 backend/.env.local 로 저장한다 (커밋 안 됨).
#   cp backend/.env.example backend/.env.local
# 모든 줄이 주석이라 그대로 복사하면 dev 기본값으로 실행된다. 바꿀 변수만 주석을 풀고 = 뒤에 값을 쓴다.
# 이 파일에는 값을 쓰지 않는다. 배포에서는 서버의 env 파일이나 GitHub Secrets로 넣는다.
# 새 변수를 코드에 추가하면 같은 PR에서 여기에 설명과 함께 추가한다.

# [DB] dev 프로필은 backend/compose.yaml의 MySQL 설정을 기본값으로 쓴다. 로컬에서는 생략한다.
# prod와 perf 프로필에는 기본값이 없다. 배포에서는 RDS 주소와 계정을 반드시 넣는다.
# 형식 예: jdbc:mysql://<호스트>:3306/<DB 이름>
# DB_URL=
# DB_USERNAME=
# DB_PASSWORD=

# [인증] JWT_SECRET은 HS256 서명 키로 32바이트 이상이다. dev 프로필에는 로컬 전용 기본값이 있어 생략한다.
# prod와 perf에서는 반드시 넣는다. 만드는 법: openssl rand -base64 48
# JWT_SECRET=
# 토큰 유효 기간은 ISO-8601 기간 형식이다. 기본은 Access 1시간(PT1H), Refresh 7일(P7D).
# JWT_ACCESS_TOKEN_TTL=
# REFRESH_TOKEN_TTL=
# true면 Refresh 쿠키를 HTTPS로만 보낸다. 기본 true. 브라우저는 http://localhost도 허용한다.
# HTTPS가 없는 서버에서 테스트할 때만 false로 둔다.
# REFRESH_COOKIE_SECURE=

# [PG] fake 또는 toss. dev 기본은 fake라 실제 PG를 호출하지 않는다. prod는 toss, perf는 항상 fake다.
# PG_PROVIDER=
# 토스페이먼츠 테스트 시크릿 키 (test_sk_로 시작). PG_PROVIDER=toss일 때와 prod에서만 필요하다.
# 개발자센터 > API 키에서 확인하거나 팀 채널로 공유받는다. 클라이언트 키는 프론트엔드에서만 쓴다.
# TOSS_SECRET_KEY=

# [가짜 PG] perf 프로필에서만 쓴다. 기본은 승인 지연 300ms, 거절, 결과 불명, 응답 유실 비율 모두 0이다.
# 비율은 0~1 사이 소수다.
# PG_FAKE_APPROVE_DELAY=
# PG_FAKE_REJECT_RATE=
# PG_FAKE_UNKNOWN_RATE=
# PG_FAKE_LOST_RESPONSE_RATE=

# [관리 포트] perf 프로필에서 actuator와 지표를 여는 포트. 기본 8081.
# MANAGEMENT_PORT=

# [스케줄러] 기본은 모두 켜짐(true). 로컬에서 로그가 많거나 데이터를 고정하고 싶을 때 false로 끈다.
# 결제 대사: 미완료 승인과 취소 조회, 기한 지난 READY 정리
# PAYMENT_RECONCILE_ENABLED=
# 경매 시작과 종료
# AUCTION_SCHEDULER_ENABLED=
# 팬미팅 응모 기간, 추첨, 주문 만료, 예비 승격
# FANMEETING_WORKER_ENABLED=

# [팬미팅 응모 자격] 행사 공지 이후 가입한 회원의 응모를 막는다. 기본 false (fanmeeting policy.md 7절).
# FANMEETING_JOINED_AT_CHECK_ENABLED=
