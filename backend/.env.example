# 백엔드 환경변수 목록. 복사해서 backend/.env.local 로 저장한다 (커밋 안 됨).
# 실제 키는 이 파일에 쓰지 않는다. 배포에서는 환경변수나 GitHub Secrets로 주입한다.
# 새 변수를 코드에 추가하면 같은 PR에서 여기에 설명과 함께 추가한다.

# [DB] dev 프로필에는 기본값이 있어 로컬에서는 생략 가능하다.
# 기본값은 backend/compose.yaml의 MySQL 설정과 같다 (restless/restless).
# prod 프로필에는 기본값이 없다. 배포에서는 RDS 주소와 계정으로 반드시 지정한다.
DB_URL=jdbc:mysql://localhost:3306/restless
DB_USERNAME=restless
DB_PASSWORD=restless

# [인증] JWT_SECRET은 HS256 서명 키로 32바이트 이상. dev 프로필에는 로컬 전용 기본값이 있어 생략 가능하다.
# prod에서는 반드시 지정한다 (예: openssl rand -base64 48).
# 토큰 유효 기간은 ISO-8601 기간 형식이다 (PT1H = 1시간, P7D = 7일).
# REFRESH_COOKIE_SECURE=true면 Refresh 쿠키를 HTTPS로만 보낸다. 브라우저는 http://localhost도 허용한다.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=PT1H
REFRESH_TOKEN_TTL=P7D
REFRESH_COOKIE_SECURE=true

# [토스페이먼츠 샌드박스] PG 승인, 취소를 호출할 때만 필요하다.
# 개발자센터 > API 키의 테스트 시크릿 키 (test_sk_로 시작). 팀 채널로 공유받는다.
# 클라이언트 키는 프론트엔드에서만 쓴다.
TOSS_SECRET_KEY=
