        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(drop_reservation_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "drop_reservation_duration_seconds_max",
          "legendFormat": "max",
          "refId": "D"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Hikari 커넥션",
